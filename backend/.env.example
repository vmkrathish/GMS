# GMS backend environment
#
# NOTE: DATABASE_URL and FRONTEND_URL are intentionally NOT set here
# — a .env file cannot override them (see app/core/config.py).
# LOCAL mode: the URL is in app/core/env_config.py.
# ONLINE mode: set DATABASE_URL as a real environment variable
# (Render → your service → Environment), using the Supabase *pooler*
# string. Never put the Supabase password in source or in this file.
#
# Everything below IS read from this file — fill in real secrets for
# your own machine/deployment, never commit the real .env to git.
JWT_SECRET=generate_a_long_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# bcrypt cost for password hashes (default 12). 10 is the OWASP minimum.
# Lower it only if the 'gms.perf: login' log shows hash time dominating.
# BCRYPT_ROUNDS=12
# Startup DB warm-up (default on, 5 connections):
# GMS_DB_WARMUP=1
# GMS_DB_WARMUP_CONNECTIONS=5
ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage — only actually used when env_config.py's
# IS_ONLINE = True. Get these from your Supabase project:
# Project Settings → API → Project URL, and the "service_role" key
# (NOT the "anon" key — service_role is required for server-side
# uploads/deletes and must never be exposed to any client app).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=gms-media

GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
